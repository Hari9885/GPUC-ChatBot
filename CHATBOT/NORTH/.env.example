ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEXT_PUBLIC_COLLEGE_NAME="Gopalan Pre-University College"
NEXT_PUBLIC_COLLEGE_CODE="GPUC"
NEXT_PUBLIC_CAMPUS_LOCATION="Yelahanka, Bengaluru"

# Gopalan Sales CRM: every enquiry is sent there (optional; the bot keeps working without it).
# The CRM admin makes these three lines with `manage.py campus_keys <campus> --chatbot` (CRM repo, deploy/README.md).
# HUB_URL = https://sales.gopalanfoundation.com
# HUB_CAMPUS = this branch's campus code on the CRM (North: gpuc-north, South: gpuc-whitefield)
# HUB_SECRET = the key from that command
# HUB_URL=
# HUB_CAMPUS=
# HUB_SECRET=
